# Full source build: identity and profile directory require native compilation.
ac_add_options --enable-application=browser
ac_add_options --target=x86_64-pc-windows-msvc
ac_add_options --with-branding=browser/branding/rechteck
ac_add_options --with-user-appdir=Rechteck
ac_add_options --with-distribution-id=io.github.migsaito.rechteck
ac_add_options --disable-updater
ac_add_options --disable-maintenance-service
ac_add_options --with-redist
export MOZ_APP_REMOTINGNAME=rechteck
export MOZ_PKG_APPNAME=rechteck-browser
mk_add_options MOZ_OBJDIR=@TOPSRCDIR@/obj-rechteck
